# Paths belong to this package even when called from an external project.
function(goose_lab_copy_relative_modules source entry_dir)
  get_filename_component(source_dir "${source}" DIRECTORY)
  set(pending "${source}")
  set(seen)
  while(pending)
    list(POP_FRONT pending module)
    if(module IN_LIST seen)
      continue()
    endif()
    list(APPEND seen "${module}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${module}")
    file(READ "${module}" body)
    get_filename_component(parent "${module}" DIRECTORY)
    string(REGEX MATCHALL "(^|[;\r\n])[ \t]*import[ \t]+\\.[A-Za-z_][A-Za-z0-9_.]*" imports "${body}")
    foreach(import IN LISTS imports)
      string(REGEX REPLACE ".*import[ \t]+\\.([A-Za-z_][A-Za-z0-9_.]*).*" "\\1" path "${import}")
      string(REPLACE "." "/" path "${path}")
      set(imported "${parent}/${path}.goose")
      if(EXISTS "${imported}" AND NOT imported STREQUAL source)
        file(RELATIVE_PATH relative "${source_dir}" "${imported}")
        get_filename_component(destination_dir "${entry_dir}/${relative}" DIRECTORY)
        file(MAKE_DIRECTORY "${destination_dir}")
        configure_file("${imported}" "${entry_dir}/${relative}" COPYONLY)
        list(APPEND pending "${imported}")
      endif()
    endforeach()
  endwhile()
endfunction()

function(goose_lab_program name source)
  cmake_parse_arguments(APP "GUI" "" "LIBRARIES;MODULE_DIRS" ${ARGN})
  if(APP_UNPARSED_ARGUMENTS)
    message(FATAL_ERROR "Unknown goose_lab_program arguments: ${APP_UNPARSED_ARGUMENTS}")
  endif()
  get_filename_component(lab_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
  get_filename_component(source "${source}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
  set(output "${CMAKE_CURRENT_BINARY_DIR}/generated/${name}.c")
  file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/generated")
  set(entry "${source}")
  if(APP_GUI)
    get_target_property(gfx_source_dir goose_gfx GOOSE_LAB_GFX_SOURCE_DIR)
    if(NOT gfx_source_dir)
      message(FATAL_ERROR "The lab graphics package has not been configured")
    endif()
    file(GLOB gfx_modules CONFIGURE_DEPENDS "${gfx_source_dir}/*.goose")
    get_filename_component(package_dir "${source}" DIRECTORY)
    set(entry_dir "${CMAKE_CURRENT_BINARY_DIR}/generated/${name}-entry")
    get_filename_component(entry_name "${source}" NAME)
    file(MAKE_DIRECTORY "${entry_dir}")
    set(entry "${entry_dir}/${entry_name}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
    file(READ "${source}" body)
    string(ASCII 239 187 191 source_bom)
    string(REGEX REPLACE "^${source_bom}" "" body "${body}")
    # Upstream only registers main() from the root file. Keep the application's
    # body at the root and resolve its adjacent modules through the first root.
    set(entry_text "import gfx from \"${gfx_source_dir}\";\n${body}")
    set(previous_entry)
    if(EXISTS "${entry}")
      file(READ "${entry}" previous_entry)
    endif()
    if(NOT previous_entry STREQUAL entry_text)
      file(WRITE "${entry}" "${entry_text}")
    endif()
    # Relative imports in the entry still resolve beside the original entry.
    goose_lab_copy_relative_modules("${source}" "${entry_dir}")
  endif()
  set(module_dirs "${lab_root}/lib" ${APP_MODULE_DIRS})
  set(module_args)
  if(APP_GUI)
    list(APPEND module_args --module-dir "${package_dir}")
  endif()
  set(modules)
  foreach(dir IN LISTS module_dirs)
    get_filename_component(dir "${dir}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    list(APPEND module_args --module-dir "${dir}")
    file(GLOB_RECURSE imports CONFIGURE_DEPENDS "${dir}/*.goose")
    list(APPEND modules ${imports})
  endforeach()
  file(GLOB_RECURSE stdlib CONFIGURE_DEPENDS "${GOOSE_SOURCE_DIR}/stdlib/*.goose")
  file(GLOB_RECURSE native_headers CONFIGURE_DEPENDS "${lab_root}/native/*.h")
  add_custom_command(OUTPUT "${output}"
    COMMAND $<TARGET_FILE:goose> --stdlib "${GOOSE_SOURCE_DIR}/stdlib"
      ${module_args} --standalone --include "${lab_root}/native/goose_lab.h"
      -o "${output}" "${entry}"
    DEPENDS goose goose_lab_toolchain_check "${entry}" "${source}" ${modules} ${stdlib} ${native_headers} ${gfx_modules}
    VERBATIM)
  add_executable(${name} "${output}")
  set_property(TARGET ${name} PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded")
  target_include_directories(${name} PRIVATE "${lab_root}/native")
  target_link_libraries(${name} PRIVATE ${APP_LIBRARIES})
  if(MSVC)
    target_compile_options(${name} PRIVATE /utf-8)
    target_link_options(${name} PRIVATE /STACK:67108864)
  elseif(WIN32)
    target_link_options(${name} PRIVATE -Wl,--stack,67108864)
  else()
    find_package(Threads REQUIRED)
    target_link_libraries(${name} PRIVATE m Threads::Threads)
  endif()
endfunction()

function(goose_lab_gui_program name source)
  if(NOT TARGET goose_lab_layout OR NOT TARGET goose_gfx)
    message(FATAL_ERROR "Enable GOOSE_LAB_GUI and initialize the lab SDL dependencies before using goose_lab_gui_program.")
  endif()
  goose_lab_program(${name} "${source}" GUI ${ARGN})
  target_link_libraries(${name} PRIVATE goose_lab_layout goose_lab_scene goose_gfx)
endfunction()
