if(NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/third_party/curl/CMakeLists.txt")
  message(FATAL_ERROR "Run git submodule update --init --recursive")
endif()
set(BUILD_CURL_EXE OFF)
set(BUILD_SHARED_LIBS OFF)
set(BUILD_STATIC_LIBS ON)
set(BUILD_TESTING OFF)
set(CURL_DISABLE_INSTALL ON)
set(CURL_USE_LIBPSL OFF)
# curl's tri-state dependency macro uses CACHE STRING, not option(). Seed typed
# defaults so its AUTO setting cannot erase ours under older CMake cache policy.
# Explicit consumer cache choices still take precedence; never FORCE this cache.
set(CURL_ZLIB OFF CACHE STRING "Build curl with ZLIB support (AUTO, ON or OFF)")
set(CURL_BROTLI OFF CACHE STRING "Build curl with brotli support (AUTO, ON or OFF)")
set(CURL_ZSTD OFF CACHE STRING "Build curl with zstd support (AUTO, ON or OFF)")
set(USE_NGHTTP2 OFF)
set(USE_LIBIDN2 OFF)
set(CURL_USE_LIBSSH2 OFF)
foreach(protocol DICT FILE FTP GOPHER IMAP LDAP LDAPS MQTT POP3 RTSP SMB SMTP TELNET TFTP)
  set(CURL_DISABLE_${protocol} ON)
endforeach()
if(WIN32)
  set(CURL_USE_SCHANNEL ON)
  set(CURL_USE_OPENSSL OFF)
else()
  set(CURL_USE_OPENSSL ON)
endif()
add_subdirectory(third_party/curl EXCLUDE_FROM_ALL)

if(NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/third_party/libuv/CMakeLists.txt")
  message(FATAL_ERROR "Initialize the libuv submodule for the I/O foundation")
endif()
set(LIBUV_BUILD_SHARED OFF)
set(LIBUV_BUILD_TESTS OFF)
set(LIBUV_BUILD_BENCH OFF)
set(ENABLE_CLANG_TIDY OFF)
add_subdirectory(third_party/libuv EXCLUDE_FROM_ALL)

if(GOOSE_LAB_GUI)
  if(NOT TARGET goose_gfx)
    message(FATAL_ERROR "Initialize the SDL submodule in GOOSE_SOURCE_DIR, or set GOOSE_LAB_GUI=OFF")
  endif()
  if(NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/third_party/clay/clay.h")
    message(FATAL_ERROR "Run git submodule update --init --recursive for Clay")
  endif()
  foreach(dependency freetype harfbuzz)
    if(NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/third_party/${dependency}/CMakeLists.txt")
      message(FATAL_ERROR "Initialize the ${dependency} submodule")
    endif()
  endforeach()
  foreach(dependency ZLIB BZIP2 PNG HARFBUZZ BROTLI)
    set(FT_DISABLE_${dependency} ON)
  endforeach()
  add_subdirectory(third_party/freetype EXCLUDE_FROM_ALL)
  set(HB_HAVE_FREETYPE ON)
  set(HB_BUILD_SUBSET OFF)
  set(HB_BUILD_UTILS OFF)
  set(HB_HAVE_CORETEXT OFF)
  add_subdirectory(third_party/harfbuzz EXCLUDE_FROM_ALL)
  if(MSVC)
    target_compile_options(freetype PRIVATE /utf-8)
    target_compile_options(harfbuzz PRIVATE /utf-8)
  endif()
endif()
