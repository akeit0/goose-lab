include("${CMAKE_CURRENT_LIST_DIR}/NativeDependencies.cmake")

# Shared policy for owned C code. Third-party options stay in the dependency file.
function(goose_lab_native_library name feature)
  cmake_parse_arguments(NATIVE "" "" "SOURCES;LIBRARIES;PRIVATE_LIBRARIES" ${ARGN})
  if(NATIVE_UNPARSED_ARGUMENTS OR NOT NATIVE_SOURCES)
    message(FATAL_ERROR "Invalid goose_lab_native_library declaration for ${name}")
  endif()
  add_library(${name} STATIC ${NATIVE_SOURCES})
  target_include_directories(${name} PUBLIC "${GOOSE_LAB_SOURCE_DIR}/native")
  target_link_libraries(${name} PUBLIC ${NATIVE_LIBRARIES})
  target_link_libraries(${name} PRIVATE ${NATIVE_PRIVATE_LIBRARIES})
  if(feature)
    target_compile_definitions(${name} INTERFACE "GOOSE_LAB_${feature}=1")
  endif()
  if(MSVC)
    target_compile_options(${name} PRIVATE /W4 /utf-8)
    target_compile_definitions(${name} PRIVATE _CRT_SECURE_NO_WARNINGS)
  else()
    target_compile_options(${name} PRIVATE -Wall -Wextra -Wpedantic)
    target_link_libraries(${name} PUBLIC m)
  endif()
endfunction()

add_subdirectory("${GOOSE_LAB_SOURCE_DIR}/native" "${CMAKE_CURRENT_BINARY_DIR}/native")
